  @font-face {
    font-family: "Vazirmatn";
    src: url(data:font/woff2;base64,) format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Vazirmatn";
    src: url(data:font/woff2;base64,) format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Vazirmatn";
    src: url(data:font/woff2;base64,) format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Vazirmatn";
    src: url(data:font/woff2;base64,) format("woff2");
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Nunito";
    src: url(data:font/ttf;base64,) format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Nunito";
    src: url(data:font/ttf;base64,) format("truetype");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Nunito";
    src: url(data:font/ttf;base64,) format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Nunito";
    src: url(data:font/ttf;base64,) format("truetype");
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --bg: #FFF6ED;
    --surface: #FFFFFF;
    --surface-2: #F5ECDF;
    --surface-shadow: #E8DCC8;
    --border: #EFE6DB;
    --text: #2C2C2B;
    --text-secondary: #8A8177;
    --accent: #7C83FD;
    --accent-dark: #5B62D6;
    --accent-soft: #EEEDFF;
    --reward: #FFB86B;
    --reward-dark: #E8973E;
    --reward-soft: #FFF1DE;
    --radius: 24px;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: linear-gradient(135deg, #FFF6ED 0%, #FFE8D6 35%, #F5ECDF 100%);
    font-family: "Vazirmatn", -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, Roboto, Arial, sans-serif;
    color: var(--text);
    -webkit-tap-highlight-color: transparent;
  }

  .viewport-stage {
    height: var(--app-height, 100dvh);
    width: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    overflow: hidden;
  }

  .app {
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .hero {
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    border-radius: 0 0 28px 28px;
    padding: 22px 20px 40px;
    color: #fff;
  }

  .hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .app-title {
    font-size: 16px;
    font-weight: 800;
  }

  .streak-pill {
    background: linear-gradient(135deg, rgba(255, 255, 255, .32), rgba(255, 184, 107, .26));
    padding: 6px 13px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 5px;
    box-shadow: 0 2px 0 rgba(0, 0, 0, .08);
  }

  .flame-icon {
    width: 16px;
    height: 16px;
    display: block;
    filter: drop-shadow(0 0 3px rgba(255, 184, 107, .9));
    transform-origin: 50% 90%;
    animation: flameFlicker 1.8s ease-in-out infinite;
  }

  @keyframes flameFlicker {

    0%,
    100% {
      transform: scale(1) rotate(0deg);
    }

    50% {
      transform: scale(1.1) rotate(-3deg);
    }
  }

  .hero-badges {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .badge-group {
    display: flex;
    gap: 8px;
  }

  .badge {
    background: rgba(255, 255, 255, .22);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 999px;
  }

  .counter-pill {
    font-size: 12px;
    font-weight: 800;
    opacity: .9;
  }

  .progress-track {
    height: 11px;
    background: rgba(255, 255, 255, .22);
    border-radius: 999px;
    overflow: hidden;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, .15);
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #FFE9D2, #ffffff);
    border-radius: 999px;
    transition: width .25s ease;
    animation: progressGlow 2.2s ease-in-out infinite;
  }

  @keyframes progressGlow {

    0%,
    100% {
      box-shadow: 0 0 6px rgba(255, 255, 255, .5);
    }

    50% {
      box-shadow: 0 0 10px rgba(255, 255, 255, .9);
    }
  }

  .content {
    position: relative;
    z-index: 2;
    margin-top: -20px;
    padding: 36px 20px 28px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .flip-tip {
    text-align: center;
    font-size: 12px;
    color: rgba(255, 255, 255, .85);
    margin-top: 14px;
  }

  .stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 26px;
  }

  .card {
    position: relative;
    width: 100%;
    max-width: 360px;
    height: 100%;
    max-height: 460px;
    min-height: 240px;
    cursor: pointer;
    perspective: 1400px;
    -webkit-perspective: 1400px;
    direction: ltr;
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    transition: transform .55s cubic-bezier(.34, 1.56, .64, 1);
    direction: ltr;
  }

  .card.flipped .card-inner {
    transform: rotateY(180deg);
    -webkit-transform: rotateY(180deg);
  }

  .face {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius);
    box-shadow: 0 18px 34px rgba(124, 131, 253, .22), 0 2px 8px rgba(0, 0, 0, .05);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px 26px;
    text-align: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    direction: ltr;
    transition: visibility 0s linear 0s;
  }

  .face.front {
    visibility: visible;
  }

  .face.back {
    transform: rotateY(180deg);
    -webkit-transform: rotateY(180deg);
    visibility: hidden;
  }

  .card.flipped .face.front {
    visibility: hidden;
    pointer-events: none;
    transition-delay: .55s;
  }

  .card.flipped .face.back {
    visibility: visible;
    transition-delay: 0s;
  }

  .card.no-anim .card-inner {
    transition: none !important;
  }

  .icon-chip {
    width: 118px;
    height: 118px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .icon {
    font-size: 54px;
    line-height: 1;
  }

  .word-en {
    direction: ltr;
    font-family: "Nunito", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    font-size: 35px;
    font-weight: 800;
    letter-spacing: .2px;
  }

  .word-en.phrase {
    font-size: 26px;
    line-height: 1.25;
  }

  .word-en.phrase-xl {
    font-size: 21px;
    line-height: 1.3;
  }

  /* === Idioms world (v2.17.0) === */
  .screen-idioms {
    flex-direction: column;
    background: #221F33;
  }

  .screen-idioms .screen-body {
    padding-top: 44px;
  }

  .idioms-header {
    text-align: center;
    margin-bottom: 26px;
    position: relative;
  }

  .idioms-header .back-btn {
    position: absolute;
    inset-inline-start: 0;
    top: 2px;
  }

  .idioms-title {
    font-size: 22px;
    font-weight: 800;
    color: #FFFFFF;
  }

  .idioms-sub {
    font-size: 13px;
    color: rgba(255, 255, 255, .55);
    margin-top: 6px;
  }

  .idioms-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .idiom-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px 12px 18px;
    border: none;
    font-family: inherit;
    text-align: center;
    cursor: pointer;
    box-shadow: 0 4px 0 rgba(0, 0, 0, .28), 0 14px 26px rgba(0, 0, 0, .30);
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1), box-shadow .1s ease;
  }

  @media (hover:hover) {
    .idiom-tile:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 0 rgba(0, 0, 0, .30), 0 18px 30px rgba(0, 0, 0, .34);
    }

    .idiom-tile:hover .idiom-icon {
      transform: scale(1.06);
    }
  }

  .idiom-tile:active {
    transform: translateY(3px) scale(.97);
    box-shadow: 0 1px 0 rgba(0, 0, 0, .28);
  }

  /* === Persistence (v2.14.0) === */
  .mark-row {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }

  .mark-btn {
    border: none;
    border-radius: 999px;
    padding: 10px 18px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    background: rgba(124, 131, 253, .10);
    color: var(--text);
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1), background .15s ease, color .15s ease, box-shadow .15s ease;
  }

  .mark-btn:active {
    transform: scale(.94);
  }

  .mark-btn.mark-known.active {
    background: #DFF5E3;
    color: #2F8659;
    box-shadow: 0 0 0 2px #2F8659 inset;
  }

  .mark-btn.mark-unknown.active {
    background: #FDE9E4;
    color: #C0563F;
    box-shadow: 0 0 0 2px #C0563F inset;
  }

  .tile-sub-everyday {
    background: #C7F264;
    border-radius: 30px 30px 30px 12px;
  }

  .tile-sub-feelings {
    background: #FF7A6B;
    border-radius: 30px 30px 12px 30px;
  }

  .tile-sub-effort {
    background: #4FD8D2;
    border-radius: 12px 30px 30px 30px;
  }

  .tile-sub-behavior {
    background: #FFD24D;
    border-radius: 30px 12px 30px 30px;
  }

  .idiom-icon {
    width: 80px;
    height: 80px;
    object-fit: contain;
    filter: drop-shadow(0 8px 12px rgba(34, 31, 51, .22));
    pointer-events: none;
    user-select: none;
    transform-origin: 50% 85%;
    transition: transform .25s cubic-bezier(.34, 1.56, .64, 1);
  }

  .idiom-name {
    font-size: 16px;
    font-weight: 800;
    color: #221F33;
  }

  .idiom-meta {
    font-size: 12px;
    color: rgba(34, 31, 51, .62);
    margin-top: -6px;
  }

  .screen-idioms.active .idioms-header {
    animation: cardStaggerIn .4s ease-out both;
  }

  .screen-idioms.active .idiom-tile {
    animation: cardStaggerIn .5s cubic-bezier(.34, 1.56, .64, 1) backwards;
  }

  .screen-idioms.active .idiom-tile:nth-child(1) {
    animation-delay: .06s;
  }

  .screen-idioms.active .idiom-tile:nth-child(2) {
    animation-delay: .16s;
  }

  .screen-idioms.active .idiom-tile:nth-child(3) {
    animation-delay: .26s;
  }

  .screen-idioms.active .idiom-tile:nth-child(4) {
    animation-delay: .36s;
  }

  .hint {
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .info-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: var(--surface-2);
    box-shadow: 0 2px 0 var(--surface-shadow);
    font-size: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1), box-shadow .1s ease;
    z-index: 2;
  }

  .info-btn.hidden {
    display: none;
  }

  .info-btn:active {
    transform: translateY(1px) scale(.9);
    box-shadow: 0 1px 0 var(--surface-shadow);
  }

  .examples-title {
    font-size: 22px;
    font-weight: 800;
    text-align: center;
    margin-bottom: 4px;
  }

  .examples-sub {
    font-size: 13px;
    color: var(--text-secondary);
    text-align: center;
    margin-bottom: 22px;
  }

  .example-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px 18px;
    margin-bottom: 14px;
    box-shadow: 0 4px 14px rgba(124, 131, 253, .08);
  }

  .example-card .en {
    direction: ltr;
    text-align: left;
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
    line-height: 1.5;
  }

  .example-card .en u {
    color: var(--accent);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .example-card .fa {
    font-size: 14px;
    color: var(--text);
    font-weight: 600;
    direction: rtl;
    line-height: 1.6;
  }

  .speak-btn {
    margin-top: 18px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: none;
    background: var(--surface-2);
    box-shadow: 0 3px 0 var(--surface-shadow);
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1), box-shadow .1s ease;
  }

  .speak-btn:active {
    transform: translateY(2px) scale(.88);
    box-shadow: 0 1px 0 var(--surface-shadow);
  }

  .meaning-fa {
    font-size: 35px;
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 0;
    direction: rtl;
  }

  .example {
    width: 100%;
    background: var(--surface-2);
    border-radius: 14px;
    padding: 14px 16px;
    margin-bottom: 12px;
  }

  .example .en {
    direction: ltr;
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .example .fa {
    font-size: 13px;
    color: var(--text-secondary);
    direction: rtl;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 4px;
  }

  .nav-btn {
    flex: 1;
    padding: 16px 0;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--text);
    font-size: 15px;
    font-weight: 800;
    font-family: inherit;
    box-shadow: 0 4px 0 var(--surface-shadow);
    transform: translateY(0);
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1), box-shadow .1s ease;
  }

  .nav-btn:active {
    transform: translateY(3px) scale(.97);
    box-shadow: 0 1px 0 var(--surface-shadow);
  }

  .nav-btn.primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 4px 0 var(--accent-dark);
  }

  .nav-btn.primary:active {
    box-shadow: 0 1px 0 var(--accent-dark);
  }

  .nav-btn:disabled {
    opacity: .4;
  }

  .celebrate-overlay {
    position: fixed;
    inset: 0;
    background: rgba(44, 34, 20, .5);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    transition: opacity .25s ease;
    z-index: 50;
  }

  .celebrate-overlay.show {
    opacity: 1;
    pointer-events: auto;
  }

  .celebrate-card {
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius);
    padding: 32px 24px;
    max-width: 320px;
    width: 100%;
    text-align: center;
    transform: translateY(12px) scale(.96);
    transition: transform .25s ease;
  }

  .celebrate-overlay.show .celebrate-card {
    transform: translateY(0) scale(1);
  }

  .celebrate-badge {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--reward-soft), var(--reward));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 52px;
    margin: 0 auto 18px;
  }

  .celebrate-title {
    font-size: 21px;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .celebrate-text {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .celebrate-btn {
    width: 100%;
    padding: 16px 0;
    border-radius: 16px;
    border: none;
    background: var(--accent);
    color: #fff;
    font-size: 15px;
    font-weight: 800;
    font-family: inherit;
    box-shadow: 0 4px 0 var(--accent-dark);
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1), box-shadow .1s ease;
  }

  .celebrate-btn:active {
    transform: translateY(3px) scale(.97);
    box-shadow: 0 1px 0 var(--accent-dark);
  }

  .confetti-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 5;
  }

  .confetti-piece {
    position: absolute;
    top: -16px;
    width: 8px;
    height: 14px;
    border-radius: 2px;
    opacity: 0;
    animation: confettiFall ease-in forwards;
  }

  @keyframes confettiFall {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }

    100% {
      transform: translate(var(--drift, 20px), 520px) rotate(var(--rot, 480deg));
      opacity: 0;
    }
  }

  /* === Version badge === */
  .version-badge {
    position: absolute;
    top: 14px;
    left: 16px;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 3px 10px;
    z-index: 10;
  }

  /* === Background blobs === */
  .bg-blob {
    position: fixed;
    border-radius: 50%;
    filter: blur(50px);
    z-index: 0;
    pointer-events: none;
    will-change: transform;
  }

  .bg-blob-1 {
    width: 340px;
    height: 340px;
    background: rgba(124, 131, 253, 0.45);
    top: -80px;
    left: -100px;
    animation: blobFloat1 22s ease-in-out infinite;
  }

  .bg-blob-2 {
    width: 300px;
    height: 300px;
    background: rgba(255, 184, 107, 0.40);
    top: 30%;
    right: -90px;
    animation: blobFloat2 28s ease-in-out infinite;
  }

  .bg-blob-3 {
    width: 260px;
    height: 260px;
    background: rgba(255, 158, 199, 0.35);
    bottom: -70px;
    left: 20%;
    animation: blobFloat3 25s ease-in-out infinite;
  }

  @keyframes blobFloat1 {

    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }

    33% {
      transform: translate(30px, 40px) scale(1.1);
    }

    66% {
      transform: translate(-20px, 20px) scale(0.95);
    }
  }

  @keyframes blobFloat2 {

    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }

    33% {
      transform: translate(-30px, -20px) scale(1.08);
    }

    66% {
      transform: translate(20px, -30px) scale(0.92);
    }
  }

  @keyframes blobFloat3 {

    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }

    33% {
      transform: translate(20px, -30px) scale(1.05);
    }

    66% {
      transform: translate(-25px, 15px) scale(0.96);
    }
  }

  .screen {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    width: 100%;
    max-width: 420px;
    height: min(var(--app-height, 100dvh), 860px);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) translateY(14px) scale(.98);
    transition: opacity .35s ease, transform .4s cubic-bezier(.22, 1, .36, 1);
    z-index: 1;
  }

  .screen.active {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, -50%) translateY(0) scale(1);
    z-index: 2;
  }

  .screen-loading {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    color: #fff;
    text-align: center;
    padding: 24px;
  }

  .loading-icon {
    font-size: 56px;
    margin-bottom: 18px;
    animation: loadingBounce 1.1s ease-in-out infinite;
  }

  @keyframes loadingBounce {

    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-14px);
    }
  }

  .loading-title {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 26px;
  }

  .loading-percent {
    font-family: "Nunito", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    font-size: 48px;
    font-weight: 800;
    direction: ltr;
    margin-bottom: 10px;
    min-width: 90px;
  }

  .loading-sub {
    font-size: 13px;
    color: rgba(255, 255, 255, .85);
  }

  .screen-category {
    flex-direction: column;
    background: var(--bg);
  }

  .category-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .category-emoji {
    font-size: 40px;
    margin-bottom: 8px;
  }

  .category-title {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -.2px;
    margin-bottom: 6px;
  }

  .category-sub {
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* === Home tiles (v2.10.0) === */
  .category-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .category-card.cat-tile {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 10px;
    padding: 22px 12px 16px;
  }

  .cat-icon-img {
    width: 86px;
    height: 86px;
    object-fit: contain;
    filter: drop-shadow(0 8px 12px rgba(44, 44, 43, .13));
    pointer-events: none;
    user-select: none;
  }

  .tile-everyday {
    background: #E5F1FF;
  }

  .tile-travel {
    background: var(--accent-soft);
  }

  .tile-food {
    background: var(--reward-soft);
  }

  .tile-work {
    background: #FFE9EC;
  }

  .tile-idioms {
    background: #E4F5EC;
  }

  .tile-review {
    background: #EFE9FF;
  }

  .category-card.idioms-banner,
  .category-card.review-banner {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    margin-top: 16px;
    padding: 14px 18px;
    text-align: right;
  }

  .idioms-banner .cat-icon-img {
    width: 62px;
    height: 62px;
  }

  .banner-text {
    flex: 1;
  }

  .soon-pill {
    font-size: 11px;
    font-weight: 800;
    color: #3E7C59;
    background: rgba(255, 255, 255, .65);
    border: 1px solid rgba(255, 255, 255, .7);
    border-radius: 999px;
    padding: 5px 12px;
    flex-shrink: 0;
  }

  .screen-category.active .idioms-banner {
    animation: cardStaggerIn .5s cubic-bezier(.34, 1.56, .64, 1) both;
    animation-delay: .46s;
  }

  .screen-category.active .review-banner {
    animation: cardStaggerIn .5s cubic-bezier(.34, 1.56, .64, 1) both;
    animation-delay: .52s;
  }

  /* === Tile liveliness (v2.10.1) === */
  .category-card.cat-tile {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    touch-action: manipulation;
  }

  .cat-icon-img {
    transform-origin: 50% 85%;
    transition: transform .25s cubic-bezier(.34, 1.56, .64, 1);
  }

  @media (hover:hover) {
    .category-card.cat-tile:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 0 rgba(232, 220, 200, 0.4), 0 20px 32px rgba(124, 131, 253, .18);
    }

    .category-card.cat-tile:hover .cat-icon-img {
      transform: scale(1.06);
    }

    .category-card.idioms-banner:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 0 rgba(232, 220, 200, 0.4), 0 20px 32px rgba(124, 131, 253, .18);
    }

    .category-card.idioms-banner:hover .cat-icon-img {
      transform: scale(1.06);
    }

    .category-card.review-banner:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 0 rgba(232, 220, 200, 0.4), 0 20px 32px rgba(124, 131, 253, .18);
    }

    .category-card.review-banner:hover .review-emoji {
      transform: scale(1.06);
    }
  }

  .category-card.cat-tile:active {
    transform: translateY(3px) scale(.97);
    box-shadow: 0 1px 0 var(--surface-shadow);
  }

  .category-card.idioms-banner:active {
    transform: translateY(3px) scale(.97);
    box-shadow: 0 1px 0 var(--surface-shadow);
  }

  .category-card.review-banner:active {
    transform: translateY(3px) scale(.97);
    box-shadow: 0 1px 0 var(--surface-shadow);
  }

  .category-card.idioms-banner:disabled {
    cursor: not-allowed;
    color: var(--text);
    -webkit-text-fill-color: var(--text);
  }

  /* === SRS review (v2.15.0) === */
  .review-emoji {
    font-size: 40px;
    line-height: 1;
    flex-shrink: 0;
    transform-origin: 50% 85%;
    transition: transform .25s cubic-bezier(.34, 1.56, .64, 1);
    pointer-events: none;
    user-select: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card.cat-tile:hover .cat-icon-img {
      transform: none;
    }

    .category-card.idioms-banner:hover .cat-icon-img {
      transform: none;
    }

    .category-card.review-banner:hover .review-emoji {
      transform: none;
    }

    .idiom-tile:hover .idiom-icon {
      transform: none;
    }
  }

  .category-card {
    display: flex;
    align-items: center;
    gap: 18px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius);
    padding: 20px 22px;
    box-shadow: 0 4px 0 rgba(232, 220, 200, 0.4), 0 14px 26px rgba(124, 131, 253, .12);
    cursor: pointer;
    border: none;
    text-align: right;
    width: 100%;
    font-family: inherit;
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1), box-shadow .1s ease;
  }

  .category-card:active {
    transform: translateY(3px) scale(.97);
    box-shadow: 0 1px 0 var(--surface-shadow);
  }

  .category-card.locked {
    opacity: .55;
    cursor: not-allowed;
  }

  .category-icon {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    background: var(--accent-soft);
    flex-shrink: 0;
  }

  .category-info {
    flex: 1;
  }

  .category-name {
    font-size: 16px;
    font-weight: 800;
    margin-bottom: 3px;
  }

  .category-meta {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .category-lock {
    font-size: 18px;
  }

  .back-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, .22);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-family: inherit;
    box-shadow: 0 3px 0 rgba(0, 0, 0, .18);
    transform: translateY(0);
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1), box-shadow .12s ease, background .15s ease;
  }

  .back-btn svg {
    width: 18px;
    height: 18px;
  }

  .back-btn:active {
    transform: translateY(2px) scale(.92);
    box-shadow: 0 1px 0 rgba(0, 0, 0, .18);
    background: rgba(255, 255, 255, .34);
  }

  .back-btn.on-light {
    background: var(--surface-2);
    color: var(--accent);
    box-shadow: 0 2px 0 var(--surface-shadow);
  }

  .back-btn.on-light:active {
    transform: translateY(2px) scale(.92);
    box-shadow: 0 1px 0 var(--surface-shadow);
    background: var(--surface-2);
  }

  .hero-top-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .screen-profile,
  .screen-settings {
    flex-direction: column;
    background: var(--bg);
  }

  .screen-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 32px 20px 110px;
  }

  .bottom-nav {
    position: absolute;
    left: 50%;
    right: auto;
    transform: translateX(-50%);
    width: min(calc(100% - 32px), 388px);
    bottom: calc((100dvh - min(100dvh, 860px)) / 2 + 14px + env(safe-area-inset-bottom, 0px));
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 6px;
    margin: 0;
    padding: 8px;
    border-radius: 999px;
  }

  .nav-bar {
    position: absolute;
    inset: 0;
    background: #221F33;
    border-radius: 999px;
    box-shadow: 0 10px 26px rgba(34, 31, 51, .30);
  }

  /* === Sliding puck nav (v2.15.1) === */
  .nav-puck {
    position: absolute;
    top: 50%;
    left: calc(100% - 8px - (100% - 28px) / 6);
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    box-shadow: 0 6px 16px rgba(124, 131, 253, .55);
    z-index: 2;
    pointer-events: none;
    transition: left .45s cubic-bezier(.3, 1.35, .5, 1);
  }

  body[data-active="category"] .nav-puck,
  body[data-active="idioms"] .nav-puck {
    left: calc(100% - 8px - (100% - 28px) / 6);
  }

  body[data-active="profile"] .nav-puck {
    left: 50%;
  }

  body[data-active="settings"] .nav-puck {
    left: calc(8px + (100% - 28px) / 6);
  }

  .puck-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    opacity: 0;
    transition: opacity .16s ease 0s;
  }

  .puck-icon svg {
    width: 21px;
    height: 21px;
  }

  /* === Nav puck flicker fix (v2.16.1) === */
  body[data-active="category"] .pi-home,
  body[data-active="idioms"] .pi-home {
    opacity: 1;
    transition: opacity .22s ease .18s;
  }

  body[data-active="profile"] .pi-profile {
    opacity: 1;
    transition: opacity .22s ease .18s;
  }

  body[data-active="settings"] .pi-settings {
    opacity: 1;
    transition: opacity .22s ease .18s;
  }

  #sharedNav {
    display: none;
  }

  body[data-active="category"] #sharedNav,
  body[data-active="idioms"] #sharedNav,
  body[data-active="profile"] #sharedNav,
  body[data-active="settings"] #sharedNav,
  body[data-active="a2"] #sharedNav {
    display: flex;
  }

  .nav-item {
    flex: 1;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 9px 6px;
    border-radius: 999px;
    border: none;
    background: transparent;
    font-family: inherit;
    color: #9490A8;
    cursor: pointer;
    transition: color .18s ease, transform .12s cubic-bezier(.34, 1.56, .64, 1);
  }

  .nav-item svg {
    width: 21px;
    height: 21px;
    position: relative;
    z-index: 1;
    transition: opacity .22s ease .28s, transform .3s cubic-bezier(.34, 1.56, .64, 1);
  }

  .nav-item span {
    font-size: 11px;
    font-weight: 800;
    position: relative;
    z-index: 1;
    transition: opacity .15s ease;
  }

  .nav-item.active {
    color: #fff;
  }

  .nav-item.active svg {
    opacity: 1;
    transition: opacity .15s ease 0s, transform .3s cubic-bezier(.34, 1.56, .64, 1);
  }

  .nav-item.active span {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {

    .nav-puck,
    .puck-icon {
      transition: none;
    }
  }

  .nav-item:active {
    transform: scale(.92);
  }

  .profile-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .profile-avatar {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    margin: 0 auto 12px;
    box-shadow: 0 8px 18px rgba(124, 131, 253, .3);
  }

  .profile-name {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -.2px;
    margin-bottom: 4px;
  }

  .profile-level {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .profile-stats {
    display: flex;
    gap: 10px;
    margin-bottom: 26px;
  }

  .stat-card {
    flex: 1;
    border-radius: 18px;
    padding: 14px 8px;
    text-align: center;
    box-shadow: 0 6px 14px rgba(124, 131, 253, .10);
  }

  .stat-icon {
    font-size: 22px;
    margin-bottom: 6px;
  }

  .stat-value {
    font-size: 18px;
    font-weight: 800;
    margin-bottom: 2px;
  }

  .stat-label {
    font-size: 11px;
    color: var(--text-secondary);
  }

  .stat-streak {
    background: rgba(255, 177, 107, 0.3);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .stat-streak .stat-value {
    color: var(--reward-dark);
  }

  .stat-words {
    background: rgba(238, 237, 255, 0.3);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .stat-words .stat-value {
    color: var(--accent-dark);
  }

  .stat-level {
    background: rgba(227, 249, 229, 0.3);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .stat-level .stat-value {
    color: #2F8659;
  }

  .profile-section {
    margin-bottom: 26px;
  }

  .section-title {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -.1px;
    margin-bottom: 14px;
  }

  .week-chart {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 18px;
    padding: 18px 14px 14px;
    box-shadow: 0 4px 0 rgba(232, 220, 200, 0.3), 0 12px 24px rgba(124, 131, 253, .10);
    height: 120px;
  }

  .week-bar {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    gap: 6px;
  }

  /* === Weekly chart upgrade (v2.16.2) === */
  .bar-track {
    position: relative;
    width: 100%;
    max-width: 28px;
    flex: 1;
    background: rgba(34, 31, 51, .06);
    border-radius: 999px;
  }

  .bar-fill {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(180deg, var(--accent), var(--accent-dark));
    border-radius: 999px;
    transform-origin: bottom;
    transform: scaleY(0);
    transition: transform .55s cubic-bezier(.34, 1.56, .64, 1);
  }

  .week-bar.today .bar-fill {
    background: linear-gradient(180deg, var(--reward), var(--reward-dark));
  }

  .week-bar span {
    font-size: 11px;
    color: var(--text-secondary);
    font-weight: 700;
  }

  .week-bar.today span {
    color: var(--reward-dark);
    font-weight: 800;
  }

  .week-chart.grown .bar-fill {
    transform: scaleY(1);
  }

  .week-bar:nth-child(1) .bar-fill {
    transition-delay: 0s;
  }

  .week-bar:nth-child(2) .bar-fill {
    transition-delay: .06s;
  }

  .week-bar:nth-child(3) .bar-fill {
    transition-delay: .12s;
  }

  .week-bar:nth-child(4) .bar-fill {
    transition-delay: .18s;
  }

  .week-bar:nth-child(5) .bar-fill {
    transition-delay: .24s;
  }

  .week-bar:nth-child(6) .bar-fill {
    transition-delay: .3s;
  }

  .week-bar:nth-child(7) .bar-fill {
    transition-delay: .36s;
  }

  .bar-value {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10px;
    font-weight: 800;
    color: rgba(34, 31, 51, .55);
    opacity: 0;
    transition: opacity .3s ease .45s;
    white-space: nowrap;
  }

  .today-dot {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--reward-dark);
    box-shadow: 0 0 0 3px rgba(255, 122, 26, .18);
    opacity: 0;
    transition: opacity .3s ease .45s;
  }

  .week-chart.grown .bar-value,
  .week-chart.grown .today-dot {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .week-chart .bar-fill {
      transform: scaleY(1);
      transition: none;
    }

    .week-chart .bar-value,
    .week-chart .today-dot {
      opacity: 1;
      transition: none;
    }
  }

  .badge-row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding: 4px 2px 8px;
  }

  .badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .hex-badge {
    width: 60px;
    height: 68px;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
  }

  .hex-badge.unlocked {
    background: linear-gradient(135deg, #EEEDFF, var(--accent));
    box-shadow: 0 4px 10px rgba(124, 131, 253, .35);
  }

  .hex-badge.locked {
    background: var(--surface-2);
    filter: grayscale(1);
    opacity: .55;
  }

  .badge-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .settings-title {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -.2px;
    text-align: center;
    margin-bottom: 28px;
  }

  .settings-section {
    margin-bottom: 22px;
  }

  .settings-section:last-child {
    margin-bottom: 0;
  }

  .settings-group-title {
    font-size: 12px;
    font-weight: 800;
    color: var(--text-secondary);
    letter-spacing: .3px;
    margin-bottom: 10px;
    padding-right: 4px;
  }

  .settings-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .settings-row {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 18px;
    padding: 16px 18px;
    box-shadow: 0 4px 0 rgba(232, 220, 200, 0.3), 0 12px 22px rgba(124, 131, 253, .10);
  }

  .settings-row-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 19px;
    flex-shrink: 0;
  }

  .settings-row-icon.chip-orange {
    background: var(--reward-soft);
  }

  .settings-row-icon.chip-purple {
    background: var(--accent-soft);
  }

  .settings-row-icon.chip-green {
    background: #E3F9E5;
  }

  /* === Real settings (v2.15.3) === */
  .settings-row-icon.chip-red {
    background: #FFDFE3;
  }

  .reminder-time-row input[type="time"] {
    font-family: inherit;
    font-size: 15px;
    font-weight: 800;
    color: var(--text);
    background: #fff;
    border: 1.5px solid rgba(34, 31, 51, .12);
    border-radius: 12px;
    padding: 8px 12px;
    direction: ltr;
  }

  .reminder-time-row input[type="time"]:disabled {
    opacity: .45;
  }

  .settings-danger {
    width: 100%;
    margin-top: 10px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 800;
    color: #D64545;
    background: #FFF5F5;
    border: 1.5px solid rgba(214, 69, 69, .25);
    border-radius: 14px;
    padding: 14px;
    cursor: pointer;
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1);
  }

  .settings-danger:active {
    transform: scale(.97);
  }

  .confirm-strip {
    display: none;
    gap: 10px;
    margin-top: 10px;
  }

  .confirm-strip button {
    flex: 1;
    font-family: inherit;
    font-size: 14px;
    font-weight: 800;
    border-radius: 14px;
    padding: 12px;
    cursor: pointer;
    border: none;
  }

  #resetYes {
    background: #D64545;
    color: #fff;
  }

  #resetCancel {
    background: #F1EEF9;
    color: var(--text);
  }

  .reminder-toast {
    position: absolute;
    left: 50%;
    right: auto;
    transform: translate(-50%, 0) translateY(12px);
    width: min(calc(100% - 48px), 372px);
    bottom: calc((100dvh - min(100dvh, 860px)) / 2 + 96px + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    background: #221F33;
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    text-align: center;
    padding: 14px 18px;
    border-radius: 18px;
    box-shadow: 0 12px 30px rgba(34, 31, 51, .35);
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity .35s ease, transform .35s cubic-bezier(.34, 1.56, .64, 1);
  }

  .reminder-toast.show {
    opacity: 1;
    transform: translate(-50%, 0) translateY(0);
    pointer-events: auto;
  }

  /* === Quiz mode (v2.16.0) === */
  .tile-quiz {
    background: #FFD9C7;
  }

  .tile-a2 {
    background: #DCEEFF;
  }

  .a2-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    color: var(--accent-dark);
    background: rgba(124, 131, 253, .14);
    border-radius: 999px;
    padding: 3px 10px;
    margin-bottom: 8px;
  }

  .screen-category.active .quiz-banner {
    animation: cardStaggerIn .5s cubic-bezier(.34, 1.56, .64, 1) both;
    animation-delay: .58s;
  }

  .screen-category.active .a2-banner {
    animation: cardStaggerIn .5s cubic-bezier(.34, 1.56, .64, 1) both;
    animation-delay: .64s;
  }

  .quiz-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .quiz-back {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border: none;
    border-radius: 12px;
    background: #fff;
    color: var(--text);
    font-size: 17px;
    font-weight: 800;
    box-shadow: 0 3px 10px rgba(34, 31, 51, .08);
    cursor: pointer;
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1);
  }

  .quiz-back:active {
    transform: scale(.9);
  }

  .quiz-progress-wrap {
    flex: 1;
    height: 8px;
    background: rgba(34, 31, 51, .08);
    border-radius: 999px;
    overflow: hidden;
  }

  .quiz-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent), var(--accent-dark));
    border-radius: 999px;
    transition: width .4s ease;
  }

  .quiz-count {
    font-size: 13px;
    font-weight: 800;
    color: var(--text);
    flex-shrink: 0;
  }

  .quiz-card {
    position: relative;
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    border-radius: 26px;
    padding: 44px 20px;
    text-align: center;
    box-shadow: 0 18px 36px rgba(124, 131, 253, .32);
    margin-bottom: 18px;
  }

  .quiz-word {
    font-size: 34px;
    font-weight: 800;
    color: #fff;
    direction: ltr;
  }

  .quiz-speak {
    position: absolute;
    bottom: 12px;
    left: 12px;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, .22);
    font-size: 16px;
    cursor: pointer;
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1);
  }

  .quiz-speak:active {
    transform: scale(.88);
  }

  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .quiz-option {
    width: 100%;
    font-family: inherit;
    font-size: 16px;
    font-weight: 800;
    color: var(--text);
    background: #fff;
    border: none;
    border-radius: 18px;
    padding: 16px 18px;
    text-align: right;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(34, 31, 51, .07);
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1), background .25s ease, color .25s ease;
  }

  .quiz-option:active {
    transform: scale(.97);
  }

  .quiz-option.locked {
    pointer-events: none;
  }

  .quiz-option.correct {
    background: #2FBD6E;
    color: #fff;
  }

  .quiz-option.wrong {
    background: #D64545;
    color: #fff;
  }

  .quiz-results {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 40px 20px;
    text-align: center;
  }

  .quiz-result-emoji {
    font-size: 64px;
  }

  .quiz-result-text {
    font-size: 24px;
    font-weight: 800;
    color: var(--text);
  }

  .quiz-result-best {
    font-size: 14px;
    font-weight: 700;
    color: rgba(34, 31, 51, .55);
  }

  .quiz-again-btn {
    width: 100%;
    margin-top: 14px;
    font-family: inherit;
    font-size: 16px;
    font-weight: 800;
    color: #fff;
    border: none;
    border-radius: 18px;
    padding: 15px;
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    box-shadow: 0 10px 22px rgba(124, 131, 253, .35);
    cursor: pointer;
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1);
  }

  .quiz-home-btn {
    width: 100%;
    font-family: inherit;
    font-size: 15px;
    font-weight: 800;
    color: var(--text);
    border: none;
    border-radius: 18px;
    padding: 14px;
    background: #F1EEF9;
    box-shadow: 0 6px 14px rgba(34, 31, 51, .10);
    cursor: pointer;
    transition: transform .12s cubic-bezier(.34, 1.56, .64, 1), box-shadow .12s ease;
  }

  .quiz-again-btn:active {
    transform: scale(.97);
    box-shadow: 0 2px 6px rgba(124, 131, 253, .25);
  }

  .quiz-home-btn:active {
    transform: scale(.97);
    box-shadow: 0 2px 5px rgba(34, 31, 51, .08);
  }

  .settings-row-info {
    flex: 1;
  }

  .settings-row-title {
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 2px;
  }

  .settings-row-sub {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .switch {
    position: relative;
    width: 44px;
    height: 26px;
    flex-shrink: 0;
  }

  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .switch-slider {
    position: absolute;
    inset: 0;
    background: var(--surface-shadow);
    border-radius: 999px;
    transition: background .2s ease;
    cursor: pointer;
  }

  .switch-slider:before {
    content: "";
    position: absolute;
    width: 20px;
    height: 20px;
    left: 3px;
    top: 3px;
    background: #fff;
    border-radius: 50%;
    transition: transform .2s ease;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .2);
  }

  .switch input:checked+.switch-slider {
    background: var(--accent);
  }

  .switch input:checked+.switch-slider:before {
    transform: translateX(18px);
  }

  .switch.disabled {
    opacity: .5;
    pointer-events: none;
  }

  /* === UI ENHANCEMENTS === */
  /* 1. Stagger animation for category cards */
  @keyframes cardStaggerIn {
    0% {
      opacity: 0;
      transform: translateY(22px) scale(.94);
    }

    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .screen-category.active .category-header {
    animation: cardStaggerIn .4s ease-out both;
  }

  .screen-category.active .category-card {
    animation: cardStaggerIn .5s cubic-bezier(.34, 1.56, .64, 1) backwards;
  }

  .screen-category.active .category-card:nth-child(1) {
    animation-delay: .06s;
  }

  .screen-category.active .category-card:nth-child(2) {
    animation-delay: .16s;
  }

  .screen-category.active .category-card:nth-child(3) {
    animation-delay: .26s;
  }

  .screen-category.active .category-card:nth-child(4) {
    animation-delay: .36s;
  }

  /* Sliding nav indicator removed in favor of dark liquid-wave bottom nav (see .nav-bg / .nav-item.active) */
  /* === Onboarding Welcome === */
  .onboard-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(24, 18, 48, .55);
    -webkit-backdrop-filter: blur(9px);
    backdrop-filter: blur(9px);
  }

  .onboard-overlay.show {
    display: flex;
  }

  .onboard-card {
    width: min(86%, 340px);
    background: #fff;
    border-radius: 24px;
    padding: 26px 20px 18px;
    text-align: center;
    box-shadow: 0 18px 50px rgba(40, 30, 90, .25);
    animation: onboardPop .35s ease;
  }

  @keyframes onboardPop {
    from {
      transform: scale(.92);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .onboard-emoji {
    font-size: 44px;
    line-height: 1;
    margin-bottom: 10px;
  }

  .onboard-title {
    font-size: 17px;
    font-weight: 800;
    color: #33305f;
    margin-bottom: 8px;
  }

  .onboard-text {
    font-size: 13px;
    line-height: 2;
    color: #6b6890;
    min-height: 78px;
  }

  .onboard-dots {
    display: flex;
    gap: 6px;
    justify-content: center;
    margin: 10px 0 14px;
  }

  .onboard-dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d9d7ee;
    transition: all .25s;
  }

  .onboard-dots span.on {
    width: 18px;
    border-radius: 6px;
    background: #6f76f2;
  }

  .onboard-slide-anim {
    animation: onboardSlide .3s ease;
  }

  @keyframes onboardSlide {
    from {
      transform: translateX(46px);
      opacity: 0;
    }

    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  .onboard-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .onboard-next {
    border: none;
    border-radius: 14px;
    padding: 12px 0;
    background: linear-gradient(135deg, #7c83fd, #5b62d6);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(91, 98, 214, .35);
  }

  .onboard-next:active {
    transform: translateY(1px) scale(.98);
  }

  .onboard-skip {
    border: none;
    background: transparent;
    color: #9a97b8;
    font-size: 12px;
    cursor: pointer;
    padding: 6px 0;
  }

  /* === Nav alignment fix === */
  /* === Nav final fix === */
  .nav-puck {
    width: 52px !important;
    height: 52px !important;
    z-index: 0 !important;
  }

  .nav-item.active svg {
    opacity: 1 !important;
  }

  .nav-item.active span {
    opacity: 1 !important;
  }

  .puck-icon {
    opacity: 0 !important;
  }